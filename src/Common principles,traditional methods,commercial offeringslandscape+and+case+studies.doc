nceTd">
<p local-id=3D"62e7c6c97ca5"><strong>Safety Events</strong></p></td>
<td data-local-id=3D"d518da7a-2e6b-475a-8b97-c8a3b68f20e6" class=3D"conflue=
nceTd">
<p local-id=3D"dadff76cff39">Incidents, near misses, stop-work events, safe=
ty meetings, hazards, corrective actions, restricted areas</p></td>
<td data-local-id=3D"29289685-401a-4530-aa80-f0715281555a" class=3D"conflue=
nceTd">
<p local-id=3D"64e34804b51a">Resulting schedule impact may appear, but <str=
ong>not the underlying safety event or circumstances</strong></p></td>
</tr>
<tr data-local-id=3D"0a62770f-f996-4219-b381-afee34c28ca0">
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"1b4e1b8f-3136-432d-8=
420-9d9fa40ea603" class=3D"confluenceTd">
<p local-id=3D"0c80984bbecc"><strong>Labor / Manpower</strong></p></td>
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"84cec9eb-67ca-4772-b=
f38-8011a9d95c42" class=3D"confluenceTd">
<p local-id=3D"955bd596b97e">Daily crew counts by contractor/trade, hours w=
orked, absenteeism, staffing shortages, and where crews were deployed</p></=
td>
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"fcf84003-1629-4cbd-9=
859-6c28889c59f8" class=3D"confluenceTd">
<p local-id=3D"bf999810335a">Planned resources if resource-loaded, but ofte=
n lacks detailed <strong>actual daily field deployment</strong></p></td>
</tr>
<tr data-local-id=3D"ffb0a908-c585-44da-a557-bdbdf9cb1de7">
<td data-local-id=3D"a17cf458-dfb8-45e0-9165-ba902f471a00" class=3D"conflue=
nceTd">
<p local-id=3D"9e349140629b"><strong>Equipment</strong></p></td>
<td data-local-id=3D"1989dc95-c0e0-4acd-80e1-9a8fa97584d9" class=3D"conflue=
nceTd">
<p local-id=3D"9a37417a1618">Equipment on site, breakdowns, idle equipment,=
 unavailable equipment, and operating hours</p></td>
<td data-local-id=3D"828e6a2a-b8c9-423a-a14f-229446d72bc1" class=3D"conflue=
nceTd">
<p local-id=3D"02c55d07342c">Scheduled activity/resource information, but g=
enerally not the detailed reason equipment was unavailable or idle</p></td>
</tr>
<tr data-local-id=3D"65b1309d-1baa-4667-9753-297ad70e1e0b">
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"adaa826b-c94a-4445-b=
b45-03adda08478c" class=3D"confluenceTd">
<p local-id=3D"0e8a15d7fd35"><strong>RFIs &amp; Design Questions</strong></=
p></td>
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"80c30e08-4af6-4603-8=
f57-fb75f3981e88" class=3D"confluenceTd">
<p local-id=3D"9e075febbc01">What information was requested, when it was re=
quested, when the response arrived, and which work was waiting for an answe=
r</p></td>
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"fa1d3d02-641d-456c-b=
b4e-dfc4e94ee713" class=3D"confluenceTd">
<p local-id=3D"d40e3fefb313">May show an impacted activity or milestone, bu=
t not necessarily the <strong>question, response, or decision history</stro=
ng></p></td>
</tr>
<tr data-local-id=3D"c2fc28dc-92b2-442c-82b1-4a1b5dc3fc26">
<td data-local-id=3D"6d8fe613-a0e8-40c0-b1b4-a4e6e41a7583" class=3D"conflue=
nceTd">
<p local-id=3D"ce3d73471682"><strong>Unforeseen Conditions</strong></p></td=
>
<td data-local-id=3D"04c8c925-2598-4fbd-9bfe-50248caa7ff3" class=3D"conflue=
nceTd">
<p local-id=3D"282dcbafed7d">Unexpected utilities, unsuitable soils, obstru=
ctions, existing-condition conflicts, access restrictions</p></td>
<td data-local-id=3D"aa34a67e-d5a2-47f7-97cc-c868e8940372" class=3D"conflue=
nceTd">
<p local-id=3D"dd77170264a1">Schedule impact can be incorporated later, but=
 the original <strong>field condition and discovery context</strong> may be=
 absent</p></td>
</tr>
<tr data-local-id=3D"6078c832-d08c-471e-9f07-db9b673a9e6d">
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"2709fafc-e202-4950-8=
5c8-e22d2e5f8f7c" class=3D"confluenceTd">
<p local-id=3D"0bc6127d7336"><strong>Material &amp; Delivery Issues</strong=
></p></td>
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"e388e10e-bc2c-4abb-a=
62c-73a6aa77fae6" class=3D"confluenceTd">
<p local-id=3D"fd4ad66d7f7f">Late/rejected deliveries, shortages, incorrect=
 materials, delivery dates, and materials actually received</p></td>
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"a8d551e0-e79f-491e-8=
e35-4198c88862cb" class=3D"confluenceTd">
<p local-id=3D"264da6276faa">Procurement activities may be scheduled, but t=
he detailed <strong>reason for a delivery disruption</strong> may not be ca=
ptured</p></td>
</tr>
<tr data-local-id=3D"8917e65c-07fd-4e4b-9814-36cc69cf7ca2">
<td data-local-id=3D"7bbffa0a-abf7-404f-a830-9c362abf4efe" class=3D"conflue=
nceTd">
<p local-id=3D"d1ee48271817"><strong>Inspections &amp; Quality</strong></p>=
</td>
<td data-local-id=3D"5f2a3daf-0866-4002-87da-d9a3f30141cd" class=3D"conflue=
nceTd">
<p local-id=3D"1df9af467a31">Failed inspections, rework, testing results, d=
eficiencies, punch-list issues, and waiting for inspectors</p></td>
<td data-local-id=3D"b65254e2-df99-4fd1-bee1-d9213f8183b9" class=3D"conflue=
nceTd">
<p local-id=3D"ecb03f121cd4">May show inspection activities or resulting de=
lays, but often lacks the underlying quality/inspection detail</p></td>
</tr>
<tr data-local-id=3D"9fa4fa02-9176-40d3-b689-ddb8d020fe6c">
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"704d69cd-e47d-47e0-b=
80a-0fd4ca3bbf2a" class=3D"confluenceTd">
<p local-id=3D"40cef0580e9a"><strong>Work Stoppages &amp; Disruptions</stro=
ng></p></td>
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"f78fbbf3-998c-4e65-a=
a15-291879ddebe0" class=3D"confluenceTd">
<p local-id=3D"58c8fdca4efc">Exact start/stop times, affected crews, locati=
ons, cause of disruption, and work that could/couldn't proceed</p></td>
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"3ecdd3ec-ffae-409c-b=
286-e23bc9fcca97" class=3D"confluenceTd">
<p local-id=3D"337e6b13dfee">Shows activity progress and resulting dates, b=
ut may not explain <strong>what happened during the day</strong></p></td>
</tr>
<tr data-local-id=3D"3c3bef57-6ab1-44a2-99d1-07ef2c857acb">
<td data-local-id=3D"25b2dc5f-da6f-480a-b6f0-52b83e31f26a" class=3D"conflue=
nceTd">
<p local-id=3D"e94538286c6a"><strong>Field Direction / Changes</strong></p>=
</td>
<td data-local-id=3D"59ba5680-c2a0-4b08-a9fc-dbcb39925b03" class=3D"conflue=
nceTd">
<p local-id=3D"ac93abc61a4a">Verbal directions, owner/architect instruction=
s, changed work, sequencing changes, and pending change orders</p></td>
<td data-local-id=3D"15ffdb84-0363-44a1-81c1-89260df5eec5" class=3D"conflue=
nceTd">
<p local-id=3D"dace354fa22e">Revised logic/durations may eventually reflect=
 the change, but not necessarily <strong>who directed it or why</strong></p=
></td>
</tr>
<tr data-local-id=3D"e33023d4-b290-43ef-b00f-84a3479097d4">
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"fc2f2906-e003-4f7c-8=
053-dfc4a5ccc298" class=3D"confluenceTd">
<p local-id=3D"959ddcfc9133"><strong>Actual Work Conditions</strong></p></t=
d>
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"4f731643-bcbd-4e18-8=
6ed-e1c0f5878a03" class=3D"confluenceTd">
<p local-id=3D"59655d0f662e">Work performed by location, productivity issue=
s, trade stacking, congestion, access limitations, and out-of-sequence work=
</p></td>
<td data-highlight-colour=3D"#c1e4f5" data-local-id=3D"db088029-35c1-4e58-9=
37e-01eb40fe2c7c" class=3D"confluenceTd">
<p local-id=3D"fb919823ffa7">Shows activity-level progress, but not necessa=
rily <strong>how the work was actually executed in the field</strong></p></=
td>
</tr>
<tr data-local-id=3D"41293d23-fc55-454a-bc98-cf451f7bf22d">
<td data-local-id=3D"edab5ee2-6b34-4b41-b362-9a4c33d8dbf2" class=3D"conflue=
nceTd">
<p local-id=3D"69bb538a2b9b"><strong>Photos &amp; Observations</strong></p>=
</td>
<td data-local-id=3D"5e9c41a4-39aa-42a9-85f6-46f47ee51c87" class=3D"conflue=
nceTd">
<p local-id=3D"fd4d399f7e22">Timestamped visual evidence of progress, condi=
tions, obstructions, deficiencies, and disruption</p></td>
<td data-local-id=3D"bc724e0e-1908-47e7-ab4f-b941e3f49b0f" class=3D"conflue=
nceTd">
<p local-id=3D"25bebb17202e">No equivalent visual record within the CPM sch=
edule itself</p></td>
</tr>
</tbody>
</table>
</div>
<p local-id=3D"e07f71665a65">&nbsp;</p><span class=3D"confluence-embedded-f=
ile-wrapper image-center-wrapper confluence-embedded-manual-size"><img clas=
s=3D"confluence-embedded-image image-center" alt=3D"image-20260923-172149.p=
ng" width=3D"468" loading=3D"lazy" src=3D"05ece2306aa4412eb7e514bf11fe1a21d=
b2d46e5d3415084b5d604e42fe0c622" data-image-src=3D"https://autodesk.atlassi=
an.net/wiki/download/attachments/1332524964/image-20260923-172149.png?versi=
on=3D1&amp;modificationDate=3D1790184115416&amp;cacheVersion=3D1&amp;api=3D=
v2" data-height=3D"437" data-width=3D"354" data-unresolved-comment-count=3D=
